# Copy this to .env and fill in real values before anything but solo local dev.

APP_NAME=LINEAGE API
ENV=development
DEBUG=true

# SQLite by default — zero setup. Switch to Postgres for anything shared:
# DATABASE_URL=postgresql+psycopg2://lineage:lineage@localhost:5432/lineage
DATABASE_URL=sqlite:///./data/lineage.db

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set to true when served over HTTPS (required in production)
AUTH_COOKIE_SECURE=false

DATA_DIR=./data
UPLOADS_DIR=./data/uploads
MAX_UPLOAD_MB=500
# Upload content sniffing: enforce (refuse disguised files), log (record only, to trial on real files), off.
UPLOAD_SNIFF_MODE=enforce
# true = also refuse audio/video whose container is not recognised (default accepts and flags it as unverified).
UPLOAD_SNIFF_STRICT_AV=false

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank for local dev — a key will be generated and persisted automatically.
FILE_ENCRYPTION_KEY=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Optional — if set, the Incident Report's summary is written by a real
# Claude API call instead of the deterministic template. Leave blank to use
# the deterministic version (always correct, just less fluent prose).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# true only when requirements-ml.txt is installed (loads the models once at startup). false = fast start, pixel-heuristic fallback.
PRELOAD_MODELS=false

# Optional search phrase generation. The investigator must consent in the UI
# before an image is sent to Gemini. LINEAGE does not fetch search results.
GEMINI_API_KEY=
GEMINI_SEARCH_MODEL=gemini-3.8-flash
MAX_WEB_SEARCHES_PER_MEDIA=3

# Phase 3A — Neo4j graph persistence (optional). Leave NEO4J_URI blank to use the
# in-memory KnowledgeGraph only. Never commit a real password; these stay server-side.
# With docker compose: NEO4J_URI=bolt://localhost:7687 (or bolt://neo4j:7687 inside compose)
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# NEO4J_CONNECT_TIMEOUT=3
# NEO4J_RETRY_SECONDS=30
# NEO4J_AUTO_SYNC=true

# Phase 3B — Investigation Copilot. Uses ANTHROPIC_API_KEY above. Set the provider to
# "none" (or leave the key blank) and the Copilot returns the retrieved graph/evidence
# context with a deterministic, grounded answer instead of calling an LLM.
COPILOT_LLM_PROVIDER=anthropic
COPILOT_MODEL=claude-opus-5-5
# COPILOT_MAX_TOKENS=4000

# Phase 2 geographic activity score (all optional; defaults shown). Thresholds apply to the 0-100 activity score.
# GEO_WEIGHT_OBSERVATIONS=3
# GEO_WEIGHT_UNIQUE_SOURCES=5
# GEO_WEIGHT_PROPAGATION_EVENTS=6
# GEO_HIGH_SCORE=60
# GEO_MEDIUM_SCORE=25

# --- Detector evaluation / demo (Phase 1-2) ---
# Optional second image-classification model; enables the two-model ensemble and the comparison in eval/.
DETECTOR_SECOND_MODEL_ID=
# Where eval/run_eval.py writes its report and the in-app Detector panel reads it.
EVAL_RESULTS_PATH=eval/results/latest.json
# true = never touch the network; models must already be cached (run scripts/prefetch_models.py once, online).
OFFLINE_DEMO_MODE=false

# --- Phase E: evidence and legal depth ---
# Ed25519 signing key for integrity manifests (base64 32-byte seed or PEM). REQUIRED outside development.
# python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
MANIFEST_SIGNING_KEY=
# Optional RFC 3161 Time-Stamp Authority. Blank = no timestamp, nothing is sent anywhere.
MANIFEST_TSA_URL=
# MANIFEST_TSA_TIMEOUT_SECONDS=10
# Abandoned page-capture sweep (grace is floored at 60 minutes in code).
CAPTURE_SWEEP_ENABLED=false
# CAPTURE_SWEEP_INTERVAL_HOURS=6
# CAPTURE_SWEEP_GRACE_MINUTES=120
# Legal review gate. Approval only counts while the reviewed version equals the running template version.
LEGAL_REVIEW_STATUS=pending
LEGAL_REVIEWED_TEMPLATE_VERSION=

# Crop/rotation-robust matching for URL tracing (ORB + RANSAC). Measured on public photos only (docs/results/);
# run it on your own demo sample before presenting. Set false to fall back to the hash-only comparison.
TRACE_FEATURE_MATCH_ENABLED=true

# --- Added in the Complete build ---
# Metadata forensics
METADATA_DATE_GAP_SECONDS=300
# Hosting lookups (RDAP) contact a public registry with a domain/IP only. Off by default.
HOSTING_RDAP_ENABLED=false
# Upload scanning: off | log | enforce. CLAMD_HOST empty = built-in EICAR and pixel-limit checks only.
# Development default is log. The production compose runs a clamav service and sets enforce.
MALWARE_SCAN_MODE=log
CLAMD_HOST=
CLAMD_PORT=3310
MAX_IMAGE_PIXELS=100000000
# Tamper-evident audit chain for new events
AUDIT_CHAIN_ENABLED=true
MFA_ISSUER=LINEAGE
PROMPT_REDACT_PII=true
# Two-factor sign-in. MFA_REQUIRED=true blocks everything except /auth/* until a user enrols.
MFA_REQUIRED=false
# Fernet key that encrypts TOTP secrets. Required outside development. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=

# Phase I-3 upload hardening. Limits are applied before image/video analysis.
MAX_VIDEO_FRAMES=1200
MAX_VIDEO_DURATION_SECONDS=600
MAX_DECOMPRESSION_RATIO=250
DECOMPRESSION_RATIO_MIN_PIXELS=20000000
UPLOAD_PROBE_TIMEOUT_SECONDS=20

# Comma-separated administrator email allow-list for /admin/operations/summary.
ADMIN_EMAILS=
